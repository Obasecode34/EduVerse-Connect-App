{
  "expo": {
    "name": "EduVerse Connect",
    "slug": "eduverse-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow EduVerse Connect to use Face ID to unlock your account."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Used to unlock your account quickly and securely."
      }
    },
    "android": {
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT"],
      "adaptiveIcon": {
        "backgroundColor": "#111827"
      }
    }
  }
}
